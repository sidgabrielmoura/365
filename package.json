{
  "name": "bet365",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:backoffice": "node --import tsx --test tests/backoffice/*.test.ts",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "check:backoffice": "node scripts/check-backoffice.cjs",
    "capture:local": "node scripts/capture-local.cjs",
    "format": "prettier --write src tests playwright.config.ts next.config.ts"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "ably": "^2.30.0",
    "ioredis": "^6.0.0",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.2",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "cheerio": "1.2.0",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
