# Explicit mode: "demo" uses local fictitious data; "backoffice" never falls back.
BACKOFFICE_MODE=backoffice
# The backoffice uses tenant branding by default. Use "clone" to preview the reference visuals.
BACKOFFICE_BRANDING=tenant
# Local development files. Leave these unset in a hosted deployment.
BACKOFFICE_TENANTS_FILE=.local/backoffice/tenants.json
BACKOFFICE_CONTRACTS_FILE=.local/backoffice/contracts.json
BACKOFFICE_CLIENT_VERSION=3.0.2
BACKOFFICE_TIMEOUT_MS=15000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BACKOFFICE_SESSION_SECRET=

# Production tenant sources. Set either BACKOFFICE_TENANTS_JSON (same shape as Redis sites) or REDIS_HOST.
BACKOFFICE_TENANTS_JSON=
REDIS_HOST=
REDIS_DB=1

# Optional read-only integration checks. Never committed.
BACKOFFICE_TEST_USERNAME=
BACKOFFICE_TEST_PASSWORD=
